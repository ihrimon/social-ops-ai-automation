{
  "name": "social-ops-ai-automation",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/backend",
    "build": "npm run build --workspace=apps/backend",
    "build:dashboard": "npm run build --workspace=apps/admin-dashboard",
    "start": "npm run start --workspace=apps/backend",
    "typecheck": "npm run typecheck --workspace=apps/backend",
    "typecheck:tests": "npm run typecheck:tests --workspace=apps/backend",
    "lint": "npm run lint --workspace=apps/backend",
    "lint:fix": "npm run lint:fix --workspace=apps/backend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "backup": "npm run backup --workspace=apps/backend",
    "test": "npm run test --workspace=apps/backend",
    "test:watch": "npm run test:watch --workspace=apps/backend",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/backend/**/*.{ts,js,mjs}": [
      "eslint --config apps/backend/eslint.config.js --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  }
}
